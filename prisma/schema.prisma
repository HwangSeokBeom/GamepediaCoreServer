generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

enum GameSource {
  STEAM
  IGDB
}

enum GameLibraryStatus {
  PLAYING
  BACKLOG
  COMPLETED
  DROPPED
}

enum ReviewCommentReactionType {
  LIKE
  DISLIKE
}

enum SteamIgdbMatchStatus {
  CONFIRMED
  CANDIDATE
  UNMATCHED
  REJECTED
}

enum UserActivityType {
  REVIEW_CREATED
  REVIEW_UPDATED
  LIKED_GAME_ADDED
  LIKED_GAME_REMOVED
  RATING_CHANGED
  PLAY_STATUS_CHANGED
  STEAM_RECENTLY_PLAYED_SYNC
}

enum UserPresenceState {
  ONLINE
  RECENTLY_ACTIVE
  PLAYING
  LAST_PLAYED
  UNKNOWN
}

// ---------------------------------------------------------------------------
// Product 2.2 — canonical game catalog, play intelligence, editorial feed.
// Every enum and model below is additive. Legacy GameSource/gameId identity
// columns stay authoritative; catalogGameId is an additional canonical index.
// ---------------------------------------------------------------------------

/// Publication state of a canonical catalog game. Personal registration is
/// immediate (PRIVATE); public visibility always passes through PENDING_REVIEW.
enum CatalogPublicationStatus {
  PRIVATE
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

/// Lifecycle of one regional service edition, not of the game work itself.
enum CatalogServiceStatus {
  ANNOUNCED
  PRE_REGISTRATION
  LIVE
  MAINTENANCE
  SUNSET_ANNOUNCED
  SHUTDOWN
}

enum CatalogIdentityProvider {
  IGDB
  STEAM
  APPLE_APP_STORE
  GOOGLE_PLAY
  OFFICIAL_SITE
  COMMUNITY
}

/// Where a stored fact came from. AI_INFERRED is never a source of truth and
/// can never be promoted to a published fact without a human confirmation.
enum CatalogProvenance {
  PROVIDER_VERIFIED
  OFFICIAL_SOURCE
  USER_CONFIRMED
  COMMUNITY_CONFIRMED
  EDITOR_VERIFIED
  AI_INFERRED
  UNKNOWN
  DISPUTED
}

enum CatalogLocalizationKind {
  ORIGINAL_TITLE
  REGIONAL_TITLE
  ALIAS
}

enum CatalogAssetKind {
  COVER
  HERO
  SCREENSHOT
  LOGO
}

enum CatalogAssetRightsStatus {
  UNKNOWN
  PROVIDER_LICENSED
  OFFICIAL_PRESS_KIT
  USER_SUBMITTED
  CLEARED
  RESTRICTED
}

enum GameSubmissionInputType {
  TEXT
  URL
  PROVIDER_ID
}

enum GameSubmissionStatus {
  PREVIEW
  PERSONAL_CONFIRMED
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum CatalogMergeDecision {
  CONFIRMED_MAPPING_MERGE
  EDITOR_MERGE
  REJECTED
  SPLIT
}

enum PlaySessionOutcome {
  CONTINUE
  PAUSED
  DROPPED
  COMPLETED
}

enum PlaySessionVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum PlaySessionMood {
  RELAXED
  FOCUSED
  EXCITED
  BORED
  FRUSTRATED
  NOSTALGIC
}

enum PlayCompassAction {
  SELECTED
  EXCLUDED
  SNOOZED
  PLAY_CONFIRMED
}

enum EditorialArticleStatus {
  DRAFT
  FACT_CHECK
  RIGHTS_REVIEW
  SCHEDULED
  PUBLISHED
  CORRECTED
  RETRACTED
}

enum ArticleSourceType {
  OFFICIAL_RSS
  STEAM_NEWS
  OFFICIAL_SITE
  EDITOR_MANUAL
}

/// Authorization roles resolved from the database on every privileged request.
/// A JWT role claim is never trusted for editor/admin decisions.
enum ProductRole {
  USER
  EDITOR
  ADMIN
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique @db.VarChar(320)
  passwordHash           String                  @map("password_hash") @db.VarChar(255)
  passwordAuthEnabled    Boolean                 @default(true) @map("password_auth_enabled")
  nickname               String                  @unique @db.VarChar(50)
  profileImageUrl        String?                 @map("profile_image_url") @db.Text
  status                 UserStatus              @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  blockedByUsers         UserBlock[]             @relation("BlockedUser")
  blockingUsers          UserBlock[]             @relation("BlockingUser")
  favoriteGames          FavoriteGame[]
  friendOf               Friendship[]            @relation("FriendshipFriend")
  friendships            Friendship[]            @relation("FriendshipUser")
  receivedFriendRequests FriendRequest[]         @relation("FriendRequestToUser")
  sentFriendRequests     FriendRequest[]         @relation("FriendRequestFromUser")
  gameLibraryEntries     UserGameLibrary[]
  activityEvents         UserActivityEvent[]
  aiRecommendationLogs   AiRecommendationLog[]
  aiSearchLogs           AiSearchLog[]
  aiUsageLimits          AiUsageLimit[]
  notifications          UserNotification[]
  passwordResetTokens    PasswordResetToken[]
  presenceSnapshot       UserPresenceSnapshot?
  privacySettings        UserPrivacySettings?
  pushTokens             UserPushToken[]
  refreshTokens          RefreshToken[]
  reportsSubmitted       Report[]                @relation("UserReports")
  reviews                Review[]
  reviewLikes            ReviewLike[]
  reviewComments         ReviewComment[]
  reviewCommentReactions ReviewCommentReaction[]
  reviewCommentReports   ReviewCommentReport[]   @relation("ReviewCommentReporter")
  socialAccounts         SocialAccount[]
  titles                 UserTitle[]
  roles                  UserRoleAssignment[]
  gameSubmissions        GameSubmission[]
  gameFollows            GameFollow[]
  playSessions           PlaySession[]
  clientMutationReceipts ClientMutationReceipt[]
  playCompassEvents      PlayCompassEvent[]
  productEvents          ProductEvent[]
  authoredArticles       EditorialArticle[]      @relation("EditorialArticleAuthor")
  articleRevisions       ArticleRevision[]

  @@map("users")
}

/// Database-backed authorization. `revokedAt IS NULL` is the only source of
/// truth for editor/admin capability checks.
model UserRoleAssignment {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  role            ProductRole
  grantedByUserId String?     @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime    @default(now()) @map("granted_at")
  revokedAt       DateTime?   @map("revoked_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId, revokedAt])
  @@index([role, revokedAt])
  @@map("user_role_assignments")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  deviceName String?   @map("device_name") @db.VarChar(100)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model Review {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  gameId          String          @map("game_id") @db.VarChar(100)
  rating          Decimal         @db.Decimal(2, 1)
  content         String          @db.Text
  containsSpoiler Boolean         @default(false) @map("contains_spoiler")
  // Additive Product 2.2 canonical index. gameId stays authoritative.
  catalogGameId   String?         @map("catalog_game_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogGame     CatalogGame?    @relation(fields: [catalogGameId], references: [id], onDelete: SetNull)
  likes           ReviewLike[]
  comments        ReviewComment[]

  @@index([gameId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, gameId, createdAt])
  @@index([catalogGameId, createdAt])
  @@map("reviews")
}

model ReviewLike {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId, createdAt])
  @@index([userId, createdAt])
  @@map("review_likes")
}

model ReviewComment {
  id               String                  @id @default(uuid()) @db.Uuid
  reviewId         String                  @map("review_id") @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  parentCommentId  String?                 @map("parent_comment_id") @db.Uuid
  rootCommentId    String                  @map("root_comment_id") @db.Uuid
  replyToCommentId String?                 @map("reply_to_comment_id") @db.Uuid
  content          String                  @db.Text
  depth            Int                     @default(0)
  isDeleted        Boolean                 @default(false) @map("is_deleted")
  deletedAt        DateTime?               @map("deleted_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  review           Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment    ReviewComment?          @relation("ReviewCommentParent", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies          ReviewComment[]         @relation("ReviewCommentParent")
  replyToComment   ReviewComment?          @relation("ReviewCommentReplyTarget", fields: [replyToCommentId], references: [id], onDelete: SetNull)
  replyTargets     ReviewComment[]         @relation("ReviewCommentReplyTarget")
  reactions        ReviewCommentReaction[]
  reports          ReviewCommentReport[]

  @@index([reviewId, parentCommentId, createdAt, id])
  @@index([reviewId, rootCommentId, createdAt, id])
  @@index([parentCommentId, createdAt, id])
  @@index([rootCommentId, createdAt, id])
  @@index([userId, createdAt, id])
  @@map("review_comments")
}

model ReviewCommentReaction {
  id           String                    @id @default(uuid()) @db.Uuid
  commentId    String                    @map("comment_id") @db.Uuid
  userId       String                    @map("user_id") @db.Uuid
  reactionType ReviewCommentReactionType @map("reaction_type")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  comment      ReviewComment             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId, reactionType, createdAt])
  @@index([userId, createdAt])
  @@map("review_comment_reactions")
}

model ReviewCommentReport {
  id             String        @id @default(uuid()) @db.Uuid
  commentId      String        @map("comment_id") @db.Uuid
  reporterUserId String        @map("reporter_user_id") @db.Uuid
  reason         String        @db.VarChar(50)
  createdAt      DateTime      @default(now()) @map("created_at")
  comment        ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterUser   User          @relation("ReviewCommentReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterUserId])
  @@index([reporterUserId, createdAt])
  @@index([commentId, createdAt])
  @@map("review_comment_reports")
}

model FavoriteGame {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  gameId        String       @map("game_id") @db.VarChar(100)
  catalogGameId String?      @map("catalog_game_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogGame   CatalogGame? @relation(fields: [catalogGameId], references: [id], onDelete: SetNull)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
  @@index([catalogGameId])
  @@map("favorite_games")
}

model FriendRequest {
  id         String              @id @default(uuid()) @db.Uuid
  fromUserId String              @map("from_user_id") @db.Uuid
  toUserId   String              @map("to_user_id") @db.Uuid
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  fromUser   User                @relation("FriendRequestFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User                @relation("FriendRequestToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, status, createdAt])
  @@index([toUserId, status, createdAt])
  @@map("friend_requests")
}

model Friendship {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  friendUserId String   @map("friend_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend       User     @relation("FriendshipFriend", fields: [friendUserId], references: [id], onDelete: Cascade)

  @@unique([userId, friendUserId])
  @@index([userId, createdAt])
  @@index([friendUserId, createdAt])
  @@map("friendships")
}

model SocialAccount {
  id                        String    @id @default(uuid()) @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  provider                  String    @db.VarChar(30)
  providerSubject           String    @map("provider_subject") @db.VarChar(255)
  personaName               String?   @map("persona_name") @db.VarChar(100)
  profileUrl                String?   @map("profile_url") @db.Text
  avatarUrl                 String?   @map("avatar_url") @db.Text
  lastSteamSyncAt           DateTime? @map("last_steam_sync_at")
  steamRecentPlayedSnapshot Json?     @map("steam_recent_played_snapshot")
  linkedAt                  DateTime  @default(now()) @map("linked_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@map("social_accounts")
}

model UserTitle {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  titleKey   String   @map("title_key") @db.VarChar(100)
  isSelected Boolean  @default(false) @map("is_selected")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, titleKey])
  @@index([userId, isSelected])
  @@map("user_titles")
}

model UserGameLibrary {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  gameSource      GameSource        @map("game_source")
  externalGameId  String            @map("external_game_id") @db.VarChar(100)
  gameName        String            @map("game_name") @db.VarChar(200)
  coverUrl        String?           @map("cover_url") @db.Text
  status          GameLibraryStatus
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  lastPlayedAt    DateTime?         @map("last_played_at")
  playtimeMinutes Int?              @map("playtime_minutes")
  catalogGameId   String?           @map("catalog_game_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogGame     CatalogGame?      @relation(fields: [catalogGameId], references: [id], onDelete: SetNull)

  @@unique([userId, gameSource, externalGameId])
  @@index([userId, status, updatedAt])
  @@index([userId, gameSource])
  @@index([catalogGameId])
  @@index([userId, catalogGameId])
  @@map("user_game_library")
}

model SteamIgdbMapping {
  id              String               @id @default(uuid()) @db.Uuid
  steamAppId      String               @unique @map("steam_appid") @db.VarChar(100)
  igdbGameId      String?              @map("igdb_game_id") @db.VarChar(100)
  matchedTitle    String?              @map("matched_title") @db.VarChar(200)
  confidenceScore Float                @map("confidence_score")
  matchStatus     SteamIgdbMatchStatus @default(UNMATCHED) @map("match_status")
  matchedAt       DateTime             @map("matched_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([igdbGameId])
  @@map("steam_igdb_mappings")
}

model Report {
  id             String   @id @default(uuid()) @db.Uuid
  reporterUserId String   @map("reporter_user_id") @db.Uuid
  targetType     String   @map("target_type") @db.VarChar(20)
  targetId       String   @map("target_id") @db.VarChar(100)
  reason         String   @db.VarChar(50)
  detail         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  reporterUser   User     @relation("UserReports", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([reporterUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("reports")
}

model UserBlock {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  blockedUser   User     @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  user          User     @relation("BlockingUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
  @@index([userId, createdAt])
  @@index([blockedUserId, createdAt])
  @@map("user_blocks")
}

model SearchQuery {
  id              String   @id @default(uuid()) @db.Uuid
  query           String   @db.VarChar(100)
  normalizedQuery String   @map("normalized_query") @db.VarChar(100)
  resultCount     Int      @map("result_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([normalizedQuery, createdAt])
  @@index([createdAt])
  @@map("search_queries")
}

model UserNotification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String    @db.VarChar(50)
  title         String    @db.VarChar(120)
  message       String    @db.Text
  relatedGameId String?   @map("related_game_id") @db.VarChar(100)
  dedupeKey     String?   @map("dedupe_key") @db.VarChar(160)
  payload       Json?
  isRead        Boolean   @default(false) @map("is_read")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([userId, dedupeKey, createdAt])
  @@map("user_notifications")
}

model UserPushToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  token       String   @db.Text
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  platform    String   @db.VarChar(20)
  deviceId    String?  @map("device_id") @db.VarChar(200)
  appVersion  String?  @map("app_version") @db.VarChar(50)
  buildNumber String?  @map("build_number") @db.VarChar(50)
  environment String?  @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, platform, environment])
  @@index([userId])
  @@index([isActive])
  @@map("user_push_tokens")
}

model UserActivityEvent {
  id             String           @id @default(uuid()) @db.Uuid
  actorUserId    String           @map("actor_user_id") @db.Uuid
  activityType   UserActivityType @map("activity_type")
  gameSource     GameSource?      @map("game_source")
  externalGameId String?          @map("external_game_id") @db.VarChar(100)
  igdbGameId     String?          @map("igdb_game_id") @db.VarChar(100)
  dedupeKey      String?          @map("dedupe_key") @db.VarChar(160)
  metadata       Json?
  isVisible      Boolean          @default(true) @map("is_visible")
  catalogGameId  String?          @map("catalog_game_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  actor          User             @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  catalogGame    CatalogGame?     @relation(fields: [catalogGameId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([activityType, createdAt])
  @@index([gameSource, externalGameId, createdAt])
  @@index([dedupeKey, createdAt])
  @@index([catalogGameId, createdAt])
  @@map("user_activity_events")
}

// Durable record of an application-owned profile-image file that must be
// removed from local storage after its owning account was deleted. Written in
// the same transaction as the user deletion; intentionally has no relation to
// User because the row must outlive the user record. userId is audit-only.
model ProfileImageCleanupTask {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  storedPathname String    @unique @map("stored_pathname") @db.Text
  attemptCount   Int       @default(0) @map("attempt_count")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  lastError      String?   @map("last_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([attemptCount, createdAt])
  @@map("profile_image_cleanup_tasks")
}

model UserPresenceSnapshot {
  userId         String            @id @map("user_id") @db.Uuid
  state          UserPresenceState @default(UNKNOWN)
  source         String?           @db.VarChar(50)
  gameSource     GameSource?       @map("game_source")
  externalGameId String?           @map("external_game_id") @db.VarChar(100)
  lastActiveAt   DateTime?         @map("last_active_at")
  lastPlayedAt   DateTime?         @map("last_played_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
  @@map("user_presence_snapshots")
}

model UserPrivacySettings {
  userId             String   @id @map("user_id") @db.Uuid
  showFriendsList    Boolean  @default(true) @map("show_friends_list")
  showRecentlyPlayed Boolean  @default(true) @map("show_recently_played")
  showLikedGames     Boolean  @default(true) @map("show_liked_games")
  showReviews        Boolean  @default(true) @map("show_reviews")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_privacy_settings")
}

model AiRecommendationLog {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  query            String   @db.Text
  normalizedQuery  String   @map("normalized_query") @db.Text
  intent           Json
  resultGameIds    String[] @map("result_game_ids")
  model            String   @db.VarChar(100)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  latencyMs        Int      @default(0) @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_recommendation_logs")
}

model AiUsageLimit {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  usageDate           DateTime @map("usage_date") @db.Date
  recommendationCount Int      @default(0) @map("recommendation_count")
  searchAssistCount   Int      @default(0) @map("search_assist_count")
  quickAddCount       Int      @default(0) @map("quick_add_count")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@index([usageDate])
  @@map("ai_usage_limits")
}

model AiSearchLog {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  query            String   @db.Text
  normalizedQuery  String   @map("normalized_query") @db.Text
  intent           Json
  resultGameIds    Int[]    @map("result_game_ids")
  model            String   @db.VarChar(100)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  latencyMs        Int      @default(0) @map("latency_ms")
  fallbackUsed     Boolean  @default(false) @map("fallback_used")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_search_logs")
}

// ===========================================================================
// Product 2.2 — Canonical game catalog
// ===========================================================================

/// One game *work*. Regional service editions live in RegionalRelease, and
/// every provider key lives in GameExternalIdentity, so the same work can be
/// reached from IGDB, Steam, the stores, or a community submission.
model CatalogGame {
  id                      String                   @id @default(uuid()) @db.Uuid
  /// Original-language title of the work. Regional titles and aliases are in
  /// GameLocalization and must not overwrite this value.
  originalTitle           String                   @map("original_title") @db.VarChar(300)
  normalizedTitle         String                   @map("normalized_title") @db.VarChar(300)
  slug                    String?                  @unique @db.VarChar(320)
  developerName           String?                  @map("developer_name") @db.VarChar(200)
  publisherName           String?                  @map("publisher_name") @db.VarChar(200)
  firstReleaseDate        DateTime?                @map("first_release_date") @db.Date
  genres                  String[]
  steamTags               String[]                 @map("steam_tags")
  platforms               String[]
  supportsSinglePlayer    Boolean?                 @map("supports_single_player")
  supportsMultiplayer     Boolean?                 @map("supports_multiplayer")
  typicalSessionMinutes   Int?                     @map("typical_session_minutes")
  publicationStatus       CatalogPublicationStatus @default(PRIVATE) @map("publication_status")
  titleProvenance         CatalogProvenance        @default(UNKNOWN) @map("title_provenance")
  /// Audit-only: the account that first registered this work. Kept as a plain
  /// UUID without a relation so catalog facts outlive account deletion.
  createdByUserId         String?                  @map("created_by_user_id") @db.Uuid
  /// Tombstone pointer written by a merge. Reads must resolve through it.
  mergedIntoCatalogGameId String?                  @map("merged_into_catalog_game_id") @db.Uuid
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  mergedInto          CatalogGame?           @relation("CatalogGameMerge", fields: [mergedIntoCatalogGameId], references: [id], onDelete: SetNull)
  mergedFrom          CatalogGame[]          @relation("CatalogGameMerge")
  localizations       GameLocalization[]
  regionalReleases    RegionalRelease[]
  identities          GameExternalIdentity[]
  assets              GameAsset[]
  fieldEvidence       GameFieldEvidence[]
  submissions         GameSubmission[]
  follows             GameFollow[]
  playSessions        PlaySession[]
  playCompassEvents   PlayCompassEvent[]
  articleLinks        ArticleGameLink[]
  reviews             Review[]
  favoriteGames       FavoriteGame[]
  libraryEntries      UserGameLibrary[]
  activityEvents      UserActivityEvent[]
  mergeAuditsAsSource CatalogMergeAudit[]    @relation("CatalogMergeSource")
  mergeAuditsAsTarget CatalogMergeAudit[]    @relation("CatalogMergeTarget")

  @@index([normalizedTitle])
  @@index([publicationStatus, updatedAt])
  @@index([mergedIntoCatalogGameId])
  @@index([createdByUserId])
  @@map("catalog_games")
}

/// Original title, per-region titles, and aliases are separate rows so a
/// regional title can never silently replace the original title.
model GameLocalization {
  id              String                  @id @default(uuid()) @db.Uuid
  catalogGameId   String                  @map("catalog_game_id") @db.Uuid
  kind            CatalogLocalizationKind
  languageCode    String                  @map("language_code") @db.VarChar(16)
  regionCode      String?                 @map("region_code") @db.VarChar(8)
  title           String                  @db.VarChar(300)
  normalizedTitle String                  @map("normalized_title") @db.VarChar(300)
  provenance      CatalogProvenance       @default(UNKNOWN)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  catalogGame     CatalogGame             @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)

  @@unique([catalogGameId, kind, languageCode, regionCode, normalizedTitle])
  @@index([normalizedTitle, languageCode])
  @@index([catalogGameId, kind])
  @@map("game_localizations")
}

/// One country/language/platform service edition of a work, with its own
/// operator, availability window, server region and lifecycle status.
model RegionalRelease {
  id            String                 @id @default(uuid()) @db.Uuid
  catalogGameId String                 @map("catalog_game_id") @db.Uuid
  countryCode   String                 @map("country_code") @db.VarChar(8)
  languageCode  String                 @map("language_code") @db.VarChar(16)
  platform      String                 @db.VarChar(40)
  operatorName  String?                @map("operator_name") @db.VarChar(200)
  serverRegion  String?                @map("server_region") @db.VarChar(60)
  releaseDate   DateTime?              @map("release_date") @db.Date
  shutdownDate  DateTime?              @map("shutdown_date") @db.Date
  serviceStatus CatalogServiceStatus   @default(ANNOUNCED) @map("service_status")
  provenance    CatalogProvenance      @default(UNKNOWN)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  catalogGame   CatalogGame            @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)
  identities    GameExternalIdentity[]
  playSessions  PlaySession[]
  follows       GameFollow[]

  @@unique([catalogGameId, countryCode, languageCode, platform])
  @@index([catalogGameId, serviceStatus])
  @@index([countryCode, serviceStatus])
  @@map("regional_releases")
}

/// Provider key for a work (and optionally one regional edition). The
/// (provider, externalId, regionKey) triple is unique in the database, so the
/// same store listing can never be attached to two canonical works.
model GameExternalIdentity {
  id                String                  @id @default(uuid()) @db.Uuid
  catalogGameId     String                  @map("catalog_game_id") @db.Uuid
  regionalReleaseId String?                 @map("regional_release_id") @db.Uuid
  provider          CatalogIdentityProvider
  externalId        String                  @map("external_id") @db.VarChar(200)
  /// 'GLOBAL' when the provider key is not region scoped. Never null so the
  /// uniqueness constraint always applies.
  regionKey         String                  @default("GLOBAL") @map("region_key") @db.VarChar(16)
  provenance        CatalogProvenance       @default(UNKNOWN)
  confidence        Float                   @default(0)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  catalogGame       CatalogGame             @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)
  regionalRelease   RegionalRelease?        @relation(fields: [regionalReleaseId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId, regionKey])
  @@index([catalogGameId])
  @@index([provider, catalogGameId])
  @@map("game_external_identities")
}

model GameAsset {
  id            String                   @id @default(uuid()) @db.Uuid
  catalogGameId String                   @map("catalog_game_id") @db.Uuid
  kind          CatalogAssetKind
  url           String                   @db.Text
  rightsStatus  CatalogAssetRightsStatus @default(UNKNOWN) @map("rights_status")
  provenance    CatalogProvenance        @default(UNKNOWN)
  attribution   String?                  @db.VarChar(300)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  catalogGame   CatalogGame              @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)

  @@unique([catalogGameId, kind, url])
  @@index([catalogGameId, kind])
  @@index([rightsStatus])
  @@map("game_assets")
}

/// Per-field provenance trail. sourceInputHash is a SHA-256 fingerprint; the
/// raw natural-language input that produced a field is never stored.
model GameFieldEvidence {
  id              String            @id @default(uuid()) @db.Uuid
  catalogGameId   String?           @map("catalog_game_id") @db.Uuid
  submissionId    String?           @map("submission_id") @db.Uuid
  fieldPath       String            @map("field_path") @db.VarChar(120)
  provenance      CatalogProvenance @default(UNKNOWN)
  confidence      Float             @default(0)
  sourceType      String            @map("source_type") @db.VarChar(40)
  sourceUrl       String?           @map("source_url") @db.Text
  sourceInputHash String?           @map("source_input_hash") @db.Char(64)
  observedAt      DateTime          @default(now()) @map("observed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  catalogGame     CatalogGame?      @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)
  submission      GameSubmission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([catalogGameId, fieldPath])
  @@index([submissionId, fieldPath])
  @@map("game_field_evidence")
}

/// A quick-add attempt. `inputFingerprint` is the SHA-256 of the normalized
/// user input; `draft` holds only structured candidate fields. Raw natural
/// language is never persisted here.
model GameSubmission {
  id                    String                   @id @default(uuid()) @db.Uuid
  userId                String                   @map("user_id") @db.Uuid
  status                GameSubmissionStatus     @default(PREVIEW)
  inputType             GameSubmissionInputType  @map("input_type")
  inputFingerprint      String                   @map("input_fingerprint") @db.Char(64)
  locale                String                   @db.VarChar(16)
  regionCode            String                   @map("region_code") @db.VarChar(8)
  platformHint          String?                  @map("platform_hint") @db.VarChar(40)
  /// Structured draft fields plus per-field provenance/confidence. Validated
  /// by Zod before every write.
  draft                 Json
  candidateSummary      Json?                    @map("candidate_summary")
  clarifyingQuestion    String?                  @map("clarifying_question") @db.VarChar(300)
  aiModel               String?                  @map("ai_model") @db.VarChar(100)
  aiFallbackUsed        Boolean                  @default(false) @map("ai_fallback_used")
  personalCatalogGameId String?                  @map("personal_catalog_game_id") @db.Uuid
  publicReviewStatus    CatalogPublicationStatus @default(PRIVATE) @map("public_review_status")
  reviewedByUserId      String?                  @map("reviewed_by_user_id") @db.Uuid
  reviewedAt            DateTime?                @map("reviewed_at")
  expiresAt             DateTime                 @map("expires_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalCatalogGame   CatalogGame?             @relation(fields: [personalCatalogGameId], references: [id], onDelete: SetNull)
  fieldEvidence         GameFieldEvidence[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, inputFingerprint, createdAt])
  @@map("game_submissions")
}

/// Append-only merge/split decision log. Automatic merges are only ever
/// written for a CONFIRMED Steam↔IGDB mapping.
model CatalogMergeAudit {
  id                  String               @id @default(uuid()) @db.Uuid
  sourceCatalogGameId String               @map("source_catalog_game_id") @db.Uuid
  targetCatalogGameId String               @map("target_catalog_game_id") @db.Uuid
  decision            CatalogMergeDecision
  reasonCode          String               @map("reason_code") @db.VarChar(60)
  evidence            Json?
  actorUserId         String?              @map("actor_user_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")
  sourceCatalogGame   CatalogGame          @relation("CatalogMergeSource", fields: [sourceCatalogGameId], references: [id], onDelete: Cascade)
  targetCatalogGame   CatalogGame          @relation("CatalogMergeTarget", fields: [targetCatalogGameId], references: [id], onDelete: Cascade)

  @@index([sourceCatalogGameId, createdAt])
  @@index([targetCatalogGameId, createdAt])
  @@index([decision, createdAt])
  @@map("catalog_merge_audits")
}

model GameFollow {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  catalogGameId     String           @map("catalog_game_id") @db.Uuid
  regionalReleaseId String?          @map("regional_release_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogGame       CatalogGame      @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)
  regionalRelease   RegionalRelease? @relation(fields: [regionalReleaseId], references: [id], onDelete: SetNull)

  @@unique([userId, catalogGameId])
  @@index([userId, createdAt])
  @@index([catalogGameId, createdAt])
  @@map("game_follows")
}

// ===========================================================================
// Product 2.2 — Playlog and play intelligence
// ===========================================================================

/// One recorded play session. `note` and `mood` are private user content: they
/// are never logged and never emitted as Product Event properties.
model PlaySession {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  catalogGameId     String                @map("catalog_game_id") @db.Uuid
  regionalReleaseId String?               @map("regional_release_id") @db.Uuid
  playedAt          DateTime              @map("played_at")
  durationMinutes   Int?                  @map("duration_minutes")
  progressPercent   Int?                  @map("progress_percent")
  mood              PlaySessionMood?
  note              String?               @db.VarChar(2000)
  outcome           PlaySessionOutcome
  visibility        PlaySessionVisibility @default(PRIVATE)
  provenance        CatalogProvenance     @default(USER_CONFIRMED)
  /// Client-supplied idempotency key. Unique per user so a retried create can
  /// never produce a duplicate session.
  clientMutationId  String                @map("client_mutation_id") @db.VarChar(120)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogGame       CatalogGame           @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)
  regionalRelease   RegionalRelease?      @relation(fields: [regionalReleaseId], references: [id], onDelete: SetNull)

  @@unique([userId, clientMutationId])
  @@index([userId, playedAt])
  @@index([userId, catalogGameId, playedAt])
  @@index([userId, outcome, playedAt])
  @@map("play_sessions")
}

/// Idempotency ledger for non-create mutations (update/delete) that carry a
/// clientMutationId. Scope keeps keys from colliding across features.
model ClientMutationReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  scope            String   @db.VarChar(60)
  clientMutationId String   @map("client_mutation_id") @db.VarChar(120)
  resourceId       String?  @map("resource_id") @db.VarChar(120)
  outcomeCode      String   @map("outcome_code") @db.VarChar(60)
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, clientMutationId])
  @@index([userId, createdAt])
  @@map("client_mutation_receipts")
}

/// Play Compass feedback. Only allowlisted actions are storable.
model PlayCompassEvent {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  catalogGameId String            @map("catalog_game_id") @db.Uuid
  action        PlayCompassAction
  requestHash   String?           @map("request_hash") @db.Char(64)
  reasonCodes   String[]          @map("reason_codes")
  occurredAt    DateTime          @map("occurred_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogGame   CatalogGame       @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, catalogGameId, action, occurredAt])
  @@map("play_compass_events")
}

// ===========================================================================
// Product 2.2 — Editorial magazine, Today feed and product controls
// ===========================================================================

model EditorialArticle {
  id                String                 @id @default(uuid()) @db.Uuid
  slug              String                 @unique @db.VarChar(200)
  status            EditorialArticleStatus @default(DRAFT)
  locale            String                 @db.VarChar(16)
  headline          String                 @db.VarChar(200)
  /// Short editorial excerpt. Never a full copy of a third-party article.
  excerpt           String                 @db.VarChar(600)
  authorUserId      String?                @map("author_user_id") @db.Uuid
  currentRevisionId String?                @map("current_revision_id") @db.Uuid
  scheduledFor      DateTime?              @map("scheduled_for")
  publishedAt       DateTime?              @map("published_at")
  correctedAt       DateTime?              @map("corrected_at")
  retractedAt       DateTime?              @map("retracted_at")
  aiDraftUsed       Boolean                @default(false) @map("ai_draft_used")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  author            User?                  @relation("EditorialArticleAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  revisions         ArticleRevision[]
  sources           ArticleSource[]
  gameLinks         ArticleGameLink[]
  assets            ArticleAsset[]

  @@index([status, publishedAt])
  @@index([locale, status, publishedAt])
  @@map("editorial_articles")
}

model ArticleRevision {
  id             String                 @id @default(uuid()) @db.Uuid
  articleId      String                 @map("article_id") @db.Uuid
  revisionNumber Int                    @map("revision_number")
  status         EditorialArticleStatus
  headline       String                 @db.VarChar(200)
  excerpt        String                 @db.VarChar(600)
  bodyMarkdown   String?                @map("body_markdown") @db.Text
  changeNote     String?                @map("change_note") @db.VarChar(300)
  aiDraft        Boolean                @default(false) @map("ai_draft")
  editorUserId   String?                @map("editor_user_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")
  article        EditorialArticle       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor         User?                  @relation(fields: [editorUserId], references: [id], onDelete: SetNull)

  @@unique([articleId, revisionNumber])
  @@index([articleId, createdAt])
  @@map("article_revisions")
}

/// Third-party reference for an article. Only the headline, a short excerpt,
/// the source URL, timestamps and a content hash are stored — never the full
/// original text.
model ArticleSource {
  id           String            @id @default(uuid()) @db.Uuid
  articleId    String            @map("article_id") @db.Uuid
  sourceType   ArticleSourceType @map("source_type")
  publisherKey String            @map("publisher_key") @db.VarChar(80)
  headline     String            @db.VarChar(300)
  excerpt      String?           @db.VarChar(400)
  sourceUrl    String            @map("source_url") @db.Text
  publishedAt  DateTime?         @map("published_at")
  fetchedAt    DateTime          @map("fetched_at")
  contentHash  String            @map("content_hash") @db.Char(64)
  provenance   CatalogProvenance @default(OFFICIAL_SOURCE)
  createdAt    DateTime          @default(now()) @map("created_at")
  article      EditorialArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, contentHash])
  @@index([publisherKey, publishedAt])
  @@map("article_sources")
}

model ArticleGameLink {
  id            String           @id @default(uuid()) @db.Uuid
  articleId     String           @map("article_id") @db.Uuid
  catalogGameId String           @map("catalog_game_id") @db.Uuid
  relation      String           @db.VarChar(40)
  createdAt     DateTime         @default(now()) @map("created_at")
  article       EditorialArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  catalogGame   CatalogGame      @relation(fields: [catalogGameId], references: [id], onDelete: Cascade)

  @@unique([articleId, catalogGameId])
  @@index([catalogGameId, createdAt])
  @@map("article_game_links")
}

model ArticleAsset {
  id           String                   @id @default(uuid()) @db.Uuid
  articleId    String                   @map("article_id") @db.Uuid
  kind         CatalogAssetKind
  url          String                   @db.Text
  rightsStatus CatalogAssetRightsStatus @default(UNKNOWN) @map("rights_status")
  attribution  String?                  @db.VarChar(300)
  isHero       Boolean                  @default(false) @map("is_hero")
  createdAt    DateTime                 @default(now()) @map("created_at")
  article      EditorialArticle         @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, url])
  @@index([articleId, isHero])
  @@map("article_assets")
}

/// Allowlisted analytics event. eventId is client generated and unique, so a
/// retried batch can never double count.
model ProductEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @unique @map("event_id") @db.VarChar(120)
  userId     String?  @map("user_id") @db.Uuid
  eventCode  String   @map("event_code") @db.VarChar(60)
  occurredAt DateTime @map("occurred_at")
  /// Allowlisted, non-free-text properties only.
  properties Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventCode, occurredAt])
  @@index([userId, occurredAt])
  @@map("product_events")
}

/// Independent kill switch overrides. A missing row means "use the configured
/// environment default", so a fresh database keeps shipped behavior.
model ProductFeatureFlag {
  key             String   @id @db.VarChar(60)
  enabled         Boolean
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("product_feature_flags")
}
