NODE_ENV=development
HOST=0.0.0.0
PORT=3001

DATABASE_URL=postgresql://username:password@localhost:5432/gamepedia_core

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

APP_WEB_BASE_URL=http://localhost:3001
API_PUBLIC_BASE_URL=http://localhost:3001
MOBILE_APP_STEAM_CALLBACK_URL=gamepedia://steam/callback
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PROFILE_IMAGE_MAX_SIZE_BYTES=5242880

MAIL_MODE=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=GamePedia <your-email@gmail.com>

APPLE_CLIENT_ID=com.example.GamePedia
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional integrations not currently used by this server.
REDIS_URL=redis://localhost:6379
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
STEAM_API_KEY=your-steam-web-api-key
STEAM_WEB_API_BASE_URL=https://api.steampowered.com/
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000
AI_RECOMMENDATION_DAILY_LIMIT=20
AI_RECOMMENDATION_CACHE_TTL_SECONDS=300
AI_LIBRARY_CURATOR_DAILY_LIMIT=20
AI_LIBRARY_CURATOR_CACHE_TTL_SECONDS=300
PRISMA_QUERY_LOGGING=false
AI_SEARCH_DAILY_LIMIT=20
AI_SEARCH_CACHE_TTL_SECONDS=300

# Gemini via OpenAI-compatible endpoint
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-google-ai-studio-api-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Groq via OpenAI-compatible endpoint
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-api-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# EC2 staging defaults
# PORT=3101
# DATABASE_URL=postgresql://username:password@localhost:5432/gamepedia_core_staging
# APP_WEB_BASE_URL=https://staging-gamepedia-api.duckdns.org
# API_PUBLIC_BASE_URL=https://staging-gamepedia-api.duckdns.org
