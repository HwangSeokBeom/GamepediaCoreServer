{
  "openapi": "3.1.0",
  "info": {
    "title": "GamePedia Cross-Platform Gate API",
    "version": "2.0.0",
    "description": "Machine-readable subset for the GamePedia 2.0 iOS/Android contract gate. This is not the complete backend API. Dates are RFC 3339 UTC date-time strings; image URLs are absolute HTTP(S) URLs or null."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": { "security": [], "summary": "Check server health", "responses": { "200": { "$ref": "#/components/responses/HealthSuccess" } } }
    },
    "/auth/refresh": {
      "post": {
        "security": [],
        "summary": "Atomically rotate a refresh token",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/RefreshSuccess" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/users/me": {
      "get": { "summary": "Get current user profile", "responses": { "200": { "$ref": "#/components/responses/ProfileSuccess" }, "401": { "$ref": "#/components/responses/Error" } } },
      "patch": { "summary": "Update current user profile", "responses": { "200": { "$ref": "#/components/responses/ProfileSuccess" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/users/me/privacy": {
      "get": { "summary": "Get privacy settings", "responses": { "200": { "$ref": "#/components/responses/PrivacySuccess" } } },
      "patch": { "summary": "Update privacy settings", "requestBody": { "$ref": "#/components/requestBodies/PrivacyUpdate" }, "responses": { "200": { "$ref": "#/components/responses/PrivacySuccess" }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/users/me/privacy-settings": {
      "get": { "deprecated": true, "summary": "iOS compatibility alias for /users/me/privacy", "responses": { "200": { "$ref": "#/components/responses/PrivacySuccess" } } },
      "patch": { "deprecated": true, "summary": "iOS compatibility alias for /users/me/privacy", "requestBody": { "$ref": "#/components/requestBodies/PrivacyUpdate" }, "responses": { "200": { "$ref": "#/components/responses/PrivacySuccess" }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/users/me/recently-played": {
      "get": { "summary": "Get current user's recently played games", "parameters": [{ "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/RecentPlaySuccess" } } }
    },
    "/users/me/recent-plays": {
      "get": { "deprecated": true, "summary": "iOS compatibility alias for /users/me/recently-played", "parameters": [{ "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/RecentPlaySuccess" } } }
    },
    "/users/me/steam": {
      "get": { "summary": "Get DB-backed Steam connection status", "responses": { "200": { "description": "Steam status", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/SteamStatus" } } }] } } } } } }
    },
    "/users/me/friends/steam/import": {
      "post": { "summary": "Refresh Steam friend discovery without creating friendships", "description": "Idempotent discovery operation. It never auto-creates GamePedia friendship rows.", "responses": { "200": { "$ref": "#/components/responses/SteamFriendImportSuccess" }, "401": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" } } }
    },
    "/users/me/recommendations/friends": {
      "get": { "summary": "Recommend games from all accepted friends", "responses": { "200": { "$ref": "#/components/responses/RecommendationSuccess" } } }
    },
    "/users/{userId}/friend-recommendations": {
      "get": { "summary": "Recommend games using one accepted friend's visible signals", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "200": { "$ref": "#/components/responses/RecommendationSuccess" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/users/me/push-token": {
      "put": { "summary": "Register or transfer a push token", "requestBody": { "$ref": "#/components/requestBodies/PushToken" }, "responses": { "200": { "$ref": "#/components/responses/PushRegistrationSuccess" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } },
      "post": { "summary": "Compatibility registration method", "requestBody": { "$ref": "#/components/requestBodies/PushToken" }, "responses": { "200": { "$ref": "#/components/responses/PushRegistrationSuccess" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } },
      "delete": { "summary": "Deactivate a push token", "description": "Accepts deviceId/token in query for deployed iOS compatibility or in a JSON body; conflicting duplicate inputs are rejected.", "parameters": [{ "name": "deviceId", "in": "query", "schema": { "type": ["string", "null"], "maxLength": 200 } }, { "name": "token", "in": "query", "schema": { "type": ["string", "null"], "minLength": 20, "maxLength": 4096 } }], "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PushTokenDeleteRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/PushDeleteSuccess" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 } },
      "UserId": { "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "requestBodies": {
      "PrivacyUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PrivacyUpdate" } } } },
      "PushToken": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PushTokenRequest" } } } }
    },
    "responses": {
      "Success": { "description": "Success envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } } },
      "HealthSuccess": { "description": "Server health", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/HealthData" } } }] } } } },
      "Error": { "description": "Shared error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "RefreshSuccess": { "description": "Rotated session", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/RefreshData" } } }] } } } },
      "ProfileSuccess": { "description": "Current user profile", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/ProfileData" } } }] } } } },
      "SteamFriendImportSuccess": { "description": "Steam friend discovery result", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/SteamFriendImportData" } } }] } } } },
      "PushRegistrationSuccess": { "description": "Push token registered", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PushRegistrationData" } } }] } } } },
      "PushDeleteSuccess": { "description": "Push token deactivated", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PushDeleteData" } } }] } } } },
      "PrivacySuccess": { "description": "Privacy settings", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PrivacySettings" } } }] } } } },
      "RecentPlaySuccess": { "description": "Recently played page", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/RecentPlayData" } } }] } } } },
      "RecommendationSuccess": { "description": "Recommendations", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "type": "object", "required": ["recommendations"], "properties": { "recommendations": { "type": "array", "items": { "$ref": "#/components/schemas/FriendRecommendation" } } } } } }] } } } }
    },
    "schemas": {
      "SuccessEnvelope": { "type": "object", "required": ["success", "data"], "properties": { "success": { "const": true }, "data": {} } },
      "HealthData": { "type": "object", "required": ["status", "push"], "properties": { "status": { "const": "ok" }, "push": { "type": "object", "required": ["enabled", "initialized", "projectId", "source", "reason"], "properties": { "enabled": { "type": "boolean" }, "initialized": { "type": "boolean" }, "projectId": { "type": ["string", "null"] }, "source": { "type": ["string", "null"] }, "reason": { "type": ["string", "null"] } } } } },
      "ErrorEnvelope": { "type": "object", "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": { "type": ["object", "array", "null"] } } } } },
      "RefreshRequest": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string", "writeOnly": true }, "deviceName": { "type": "string", "maxLength": 100 } } },
      "RefreshData": { "type": "object", "required": ["user", "tokens"], "properties": { "user": { "$ref": "#/components/schemas/User" }, "tokens": { "type": "object", "required": ["accessToken", "refreshToken"], "properties": { "accessToken": { "type": "string", "readOnly": true }, "refreshToken": { "type": "string", "readOnly": true } } } } },
      "User": { "type": "object", "required": ["id", "email", "nickname", "status", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "email": { "type": "string", "format": "email" }, "nickname": { "type": "string" }, "profileImageUrl": { "type": ["string", "null"], "format": "uri" }, "status": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "ProfileData": { "type": "object", "required": ["user"], "properties": { "user": { "$ref": "#/components/schemas/User" }, "friendCount": { "type": "integer", "minimum": 0 }, "likeCount": { "type": "integer", "minimum": 0 }, "reviewCount": { "type": "integer", "minimum": 0 }, "recentlyPlayed": { "type": "array", "items": { "$ref": "#/components/schemas/RecentGame" } }, "hasMoreRecentPlayed": { "type": "boolean" } } },
      "PrivacyUpdate": { "type": "object", "minProperties": 1, "properties": { "showFriendsList": { "type": "boolean" }, "showRecentlyPlayed": { "type": "boolean" }, "showLikedGames": { "type": "boolean" }, "showReviews": { "type": "boolean" }, "isFriendsListPublic": { "type": "boolean", "deprecated": true }, "isRecentPlayPublic": { "type": "boolean", "deprecated": true }, "isLikedGamesPublic": { "type": "boolean", "deprecated": true }, "isReviewsPublic": { "type": "boolean", "deprecated": true } } },
      "PrivacySettings": { "type": "object", "required": ["showFriendsList", "showRecentlyPlayed", "showLikedGames", "showReviews", "isFriendsListPublic", "isRecentPlayPublic", "isLikedGamesPublic", "isReviewsPublic"], "properties": { "privacy": { "type": "object" }, "showFriendsList": { "type": "boolean" }, "showRecentlyPlayed": { "type": "boolean" }, "showLikedGames": { "type": "boolean" }, "showReviews": { "type": "boolean" }, "isFriendsListPublic": { "type": "boolean" }, "isRecentPlayPublic": { "type": "boolean" }, "isLikedGamesPublic": { "type": "boolean" }, "isReviewsPublic": { "type": "boolean" }, "steamFriendsFeatureAvailable": { "type": "boolean" } } },
      "SteamStatus": { "type": "object", "required": ["isLinked", "steamId", "displayName", "personaName", "profileUrl", "canSync", "canDisconnect", "lastSteamSyncAt"], "properties": { "isLinked": { "type": "boolean" }, "steamId": { "type": ["string", "null"] }, "steamId64": { "type": ["string", "null"] }, "displayName": { "type": ["string", "null"] }, "personaName": { "type": ["string", "null"] }, "profileUrl": { "type": ["string", "null"], "format": "uri" }, "canSync": { "type": "boolean" }, "canDisconnect": { "type": "boolean" }, "lastSteamSyncAt": { "type": ["string", "null"], "format": "date-time" } } },
      "RecentGame": { "type": "object", "required": ["externalGameId", "gameSource"], "properties": { "gameId": { "type": ["integer", "null"] }, "externalGameId": { "type": "string" }, "gameSource": { "type": "string", "enum": ["steam", "igdb"] }, "name": { "type": ["string", "null"] }, "coverUrl": { "type": ["string", "null"], "format": "uri" }, "lastPlayedAt": { "type": ["string", "null"], "format": "date-time" }, "playtimeMinutes": { "type": ["integer", "null"], "minimum": 0 } } },
      "RecentPlayData": { "type": "object", "required": ["games", "recentGames", "recentlyPlayed", "recentPlayedPreview", "hasMoreRecentPlayed"], "properties": { "games": { "type": "array", "items": { "$ref": "#/components/schemas/RecentGame" } }, "recentGames": { "type": "array", "items": { "$ref": "#/components/schemas/RecentGame" } }, "recentlyPlayed": { "type": "array", "items": { "$ref": "#/components/schemas/RecentGame" } }, "recentPlayedPreview": { "type": "array", "items": { "$ref": "#/components/schemas/RecentGame" } }, "hasMoreRecentPlayed": { "type": "boolean" } } },
      "FriendRecommendation": { "type": "object", "required": ["game"], "properties": { "game": { "type": "object" }, "reason": { "type": ["string", "null"] } } },
      "SteamFriendImportData": { "type": "object", "required": ["friends", "steamFriendsAvailable", "steamFriendsLimitedByPrivacy", "syncWarningCode"], "properties": { "friends": { "type": "array", "items": { "type": "object", "required": ["steamId64"], "properties": { "steamId64": { "type": "string" }, "isLinkedToGamePedia": { "type": "boolean" }, "userId": { "type": ["string", "null"], "format": "uuid" }, "nickname": { "type": ["string", "null"] }, "profileImageUrl": { "type": ["string", "null"], "format": "uri" } } } }, "steamFriendsAvailable": { "type": "boolean" }, "steamFriendsLimitedByPrivacy": { "type": "boolean" }, "syncWarningCode": { "type": ["string", "null"] } } },
      "PushTokenRequest": { "type": "object", "required": ["token", "platform"], "properties": { "token": { "type": "string", "minLength": 20, "maxLength": 4096, "writeOnly": true }, "platform": { "type": "string", "enum": ["ios", "android"] }, "deviceId": { "type": "string", "maxLength": 200 }, "appVersion": { "type": "string", "maxLength": 50 }, "buildNumber": { "type": "string", "maxLength": 50 }, "environment": { "type": "string", "maxLength": 50 } } },
      "PushTokenDeleteRequest": { "type": "object", "anyOf": [{ "required": ["deviceId"] }, { "required": ["token"] }], "properties": { "deviceId": { "type": "string", "maxLength": 200 }, "token": { "type": "string", "minLength": 20, "maxLength": 4096, "writeOnly": true } } },
      "PushRegistrationData": { "type": "object", "required": ["registered"], "properties": { "registered": { "const": true } } },
      "PushDeleteData": { "type": "object", "required": ["deactivated", "updatedCount"], "properties": { "deactivated": { "const": true }, "updatedCount": { "type": "integer", "minimum": 0 } } }
    }
  }
}
