NODE_ENV=staging
APP_ENV=staging
HOST=0.0.0.0
PORT=3101

DATABASE_URL=postgresql://username:password@127.0.0.1:5432/gamepedia_core_staging
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

APP_WEB_BASE_URL=https://staging-gamepedia-api.duckdns.org
API_PUBLIC_BASE_URL=https://staging-gamepedia-api.duckdns.org
MOBILE_APP_STEAM_CALLBACK_URL=gamepedia://steam/callback
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PROFILE_IMAGE_MAX_SIZE_BYTES=5242880

# MAIL_MODE=log is rejected outside development/test; SMTP is required.
MAIL_MODE=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=mailer@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=GamePedia <no-reply@example.com>

# Pre-listen SMTP verification (mandatory outside development/test).
# A failed verification aborts startup; see docs/smtp-startup-readiness.md.
# SMTP_VERIFY_ON_STARTUP=true
# SMTP_VERIFY_TIMEOUT_MS=10000

APPLE_CLIENT_ID=com.example.GamePedia
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
STEAM_API_KEY=your-steam-web-api-key
STEAM_WEB_API_BASE_URL=https://api.steampowered.com/
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000
AI_RECOMMENDATION_DAILY_LIMIT=20
AI_RECOMMENDATION_CACHE_TTL_SECONDS=300
AI_LIBRARY_CURATOR_DAILY_LIMIT=20
AI_LIBRARY_CURATOR_CACHE_TTL_SECONDS=300
PRISMA_QUERY_LOGGING=false
AI_SEARCH_DAILY_LIMIT=20
AI_SEARCH_CACHE_TTL_SECONDS=300

# Firebase Admin SDK for FCM push. Prefer Secret Manager or base64 env on servers.
FIREBASE_ADMIN_CREDENTIALS_BASE64=
# FIREBASE_ADMIN_CREDENTIALS_PATH=
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Groq via OpenAI-compatible endpoint
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-api-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
